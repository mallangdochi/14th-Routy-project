@@ -0,0 +1,55 @@
+/** 이미지가 없거나 깨졌을 때 서버의 다음 이미지 검색으로 복구합니다. */
+export type PhotoTarget = {
+  name: string;
+  address: string;
+  lat?: number | null;
+  lng?: number | null;
+};
+
+const results = new Map<string, { image: string | null; expires: number }>();
+const inFlight = new Map<string, Promise<string | null>>();
+
+/** 번들링 시 해시가 붙는 Routy 기본 캐릭터 사진도 감지합니다. */
+export function isDefaultPlaceImage(value: string | null | undefined): boolean {
+  if (!value?.trim()) return true;
+  return /(?:^|\/)(?:where2?|SearchMascot)(?:-[A-Za-z0-9_-]+)?\.webp(?:[?#].*)?$/i.test(value);
+}
+
+export function findDaumFallbackPhoto(place: PhotoTarget): Promise<string | null> {
+  if (!place.name.trim() || !place.address.trim()) return Promise.resolve(null);
+  const key = JSON.stringify([place.name, place.address, place.lat, place.lng]);
+  const cached = results.get(key);
+  if (cached && cached.expires > Date.now()) return Promise.resolve(cached.image);
+  const running = inFlight.get(key);
+  if (running) return running;
+
+  const params = new URLSearchParams({
+    name: place.name,
+    address: place.address,
+    prefer: "daum",
+    v: "photo-fallback-5",
+  });
+  if (typeof place.lat === "number" && Number.isFinite(place.lat))
+    params.set("lat", String(place.lat));
+  if (typeof place.lng === "number" && Number.isFinite(place.lng))
+    params.set("lng", String(place.lng));
+
+  const task = fetch(`/api/tour/photos?${params}`, {
+    signal: AbortSignal.timeout(12000),
+  }).then(async (response): Promise<string | null> => {
+    if (!response.ok) return null;
+    const payload: unknown = await response.json();
+    if (!payload || typeof payload !== "object") return null;
+    const image = (payload as { image?: unknown }).image;
+    return typeof image === "string" && image.startsWith("https://") ? image : null;
+  }).catch((): null => null).then((image) => {
+    if (results.size > 400) results.clear();
+    results.set(key, {
+      image,
+      expires: Date.now() + (image ? 6 * 60 * 60 * 1000 : 30 * 1000),
+    });
+    return image;
+  }).finally(() => inFlight.delete(key));
+  inFlight.set(key, task);
+  return task;
+}
